[Unit]
Description=agentmobile IM bridge service
Documentation=file:__ROOT__/docs/SERVICES.md
After=network.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__
ExecStart=__NPM_BINARY__ run start:im
Restart=on-failure
RestartSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=PATH=__RUNTIME_PATH__

[Install]
WantedBy=multi-user.target
