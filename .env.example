# =============================================================
# agentmobile 配置文件
# 使用方法: cp .env.example .env
# 默认值已填好，可直接启动。生产环境请务必修改密码和密钥。
# =============================================================

# JWT 签名密钥
# ⚠️  生产环境请替换：openssl rand -hex 32
JWT_SECRET=fcea4c5c28bee4c9fa7adca25c947f87b2a7179202c824d185618d3b3bf2a333

# 登录密码的 bcrypt hash
# 默认账号: wangxumarshall@qq.com
# 默认密码: agentmobile
# ⚠️  生产环境请替换（生成新 hash）:
#   node -e "const b=require('bcrypt');b.hash('yourpassword',12).then(h=>console.log(h))"
ACC_PASSWORD_HASH=$2b$12$Sp9PHEwZUwB5Q3jKRM2bFeMAzvgmZyGofZpsJ2ZkyqsS1r9jmV6Jy

# 要 attach 的 tmux session 名（不存在会自动创建）
TMUX_SESSION=main

# tmux/xterm 历史保留行数
TMUX_HISTORY_LIMIT=50000

# 工作区根目录（AI agent 能访问的文件系统路径）
# 改为你实际的工作目录，例如 /home/yourname/work 或 /root
WORKSPACE_ROOT=/home

# 服务监听端口
PORT=5000

# 代理（Claude Code 和 Codex CLI 共用，格式: http://host:port，不需要则留空）
PROXY=

# Claude Code 专用代理（覆盖 PROXY）
# 格式: http://host:port
CLAUDE_PROXY=

# Codex CLI 专用代理（覆盖 PROXY）
# 格式: http://host:port
CODEX_PROXY=

# OpenAI API Key（Codex CLI 自动从 ~/.codex/ 读取，这里仅用于自动创建 codex profile）
OPENAI_API_KEY=

# OpenAI API Base URL（自定义 endpoint，例如通过代理或第三方）
OPENAI_BASE_URL=

# Telegram Bot Token（可选）
# 获取方式: @BotFather → /newbot → 复制 token
TELEGRAM_BOT_TOKEN=

# Telegram Webhook Secret（可选，用于验证 Telegram 来源）
# 注意：正式 IM bridge 使用 agentmobile-im polling，启动时会清理旧 webhook。
# server.js 的 /api/webhooks/telegram 仅保留为 legacy 入口。
# 生成: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# Telegram 默认使用的 tmux 窗口名（留空则使用第一个窗口）
TELEGRAM_DEFAULT_SESSION=

# 是否在 Telegram 显示 tool call / activity cards
TELEGRAM_SHOW_TOOL_CALL_CARDS=false

# =============================================================
# IM Bridge（Telegram / Feishu）
# 独立进程入口: npm run start:im
# systemd 托管服务: agentmobile-im.service（详见 docs/SERVICES.md）
# =============================================================

# 是否启用 IM bridge 总开关
IM_BRIDGE_ENABLED=false

# 启用 Telegram adapter（仅在 IM_BRIDGE_ENABLED=true 时生效）
TELEGRAM_ENABLED=true

# 启用 Feishu / Lark adapter（仅在 IM_BRIDGE_ENABLED=true 时生效）
FEISHU_ENABLED=false

# IM bridge 运行时数据目录（bindings / sessions / cache）
CTI_HOME=./im-data

# IM 默认工作目录（未显式指定时）
CTI_DEFAULT_WORKDIR=/home

# Claude Code 可执行文件路径或命令名
CTI_CLAUDE_CODE_EXECUTABLE=claude

# Feishu / Lark 应用配置
# 也可在 Web Settings → Feishu 中扫码初始化，成功后会自动写入下面的 app id / secret
CTI_FEISHU_APP_ID=
CTI_FEISHU_APP_SECRET=

# 飞书卡片按钮回调 HTTP 入口
# 对外 URL 路径固定为 /api/webhooks/feishu/card-action
# 留空或 0 表示不启动回调端口，此时权限按钮等卡片交互不可用
CTI_FEISHU_CALLBACK_PORT=0
CTI_FEISHU_VERIFICATION_TOKEN=
CTI_FEISHU_ENCRYPT_KEY=

# 海外 Lark 场景填 lark，国内飞书留空
CTI_FEISHU_DOMAIN=

# 允许使用 IM bridge 的 Feishu open_id，逗号分隔；为空表示不限制
CTI_FEISHU_ALLOWED_USERS=

# 是否在飞书显示 tool call / activity cards
CTI_FEISHU_SHOW_TOOL_CALL_CARDS=false

# GitHub 仓库（用于检查更新），格式: owner/repo
# Fork 用户改为自己的 repo
GITHUB_REPO=wangxumarshall/agentmobile
