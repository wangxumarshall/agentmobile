{
  "name": "agentmobile",
  "version": "4.6.0-im",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:im": "node --import tsx im/server-im.ts",
    "dev": "node --watch server.js",
    "dev:im": "tsx watch im/server-im.ts",
    "setup": "node scripts/setup.js",
    "docs:index": "node scripts/generate-docs-index.js",
    "commit:auto": "node scripts/auto-commit.js --message \"chore(repo): sync local changes\"",
    "commit:auto:push": "node scripts/auto-commit.js --message \"chore(repo): sync local changes\" --push",
    "build:im": "tsc --noEmit",
    "service:help": "scripts/service-control.sh help",
    "service:status": "scripts/service-control.sh status",
    "service:logs": "scripts/service-control.sh logs",
    "service:verify": "scripts/service-control.sh verify",
    "service:install-units": "scripts/service-control.sh install-units",
    "service:pull:web": "scripts/service-control.sh pull-web",
    "service:deploy:web": "scripts/service-control.sh deploy-web",
    "service:restart:web": "scripts/service-control.sh restart-web",
    "service:pull:all": "scripts/service-control.sh pull-all",
    "service:deploy:all": "scripts/service-control.sh deploy-all",
    "service:deploy:im": "scripts/service-control.sh deploy-im",
    "service:restart:im": "scripts/service-control.sh restart-im",
    "service:migrate-tmux": "scripts/service-control.sh migrate-tmux",
    "service:restart:tmux": "scripts/service-control.sh restart-tmux",
    "test": "npm run build:im && npm run test:unit",
    "test:unit": "node tests/auth.test.mjs && npx tsx frontend/src/auth.test.ts && npx tsx frontend/src/mobileInput.test.ts && npx tsx frontend/src/mobileKeyboard.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.81",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "bcrypt": "^6.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^14.1.1",
    "multer": "^2.1.1",
    "node-pty": "^1.2.0-beta.12",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "tsx": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22",
    "typescript": "^5.4.5"
  }
}
