[Unit]
Description=agentmobile WebSocket tmux bridge service
Documentation=file:__ROOT__/docs/SERVICES.md
After=network.target agentmobile-tmux.service
Requires=agentmobile-tmux.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__
ExecStart=__NODE_BINARY__ __ROOT__/server.js
Restart=on-failure
RestartSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=PATH=__RUNTIME_PATH__

[Install]
WantedBy=multi-user.target
