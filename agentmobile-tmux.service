[Unit]
Description=agentmobile persistent tmux runtime
Documentation=file:__ROOT__/docs/SERVICES.md
After=network.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/scripts/tmux-runtime.sh
Restart=always
RestartSec=10
KillMode=control-group
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=PATH=__RUNTIME_PATH__

[Install]
WantedBy=multi-user.target
